generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String
  role     Role

  greenhouseId String?
  staffOf      Greenhouse? @relation("StaffGreenhouse", fields: [greenhouseId], references: [id])

  staffRoleId String?
  staffRoles  StaffRoles? @relation(fields: [staffRoleId], references: [id])

  ownedGreenhouses Greenhouse[] @relation("OwnerGreenhouse")

  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Greenhouse {
  id       String  @id @default(uuid())
  name     String
  location String?

  ownerId String
  owner   User   @relation("OwnerGreenhouse", fields: [ownerId], references: [id])

  staff User[] @relation("StaffGreenhouse")

  staffRoles StaffRoles[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model StaffRoles {
  id          String  @id @default(uuid())
  name        String
  description String?

  permissions Json

  greenhouseId String
  greenhouse   Greenhouse @relation(fields: [greenhouseId], references: [id])

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, greenhouseId])
}

enum Role {
  SUPER_ADMIN
  OWNER
  STAFF
}
